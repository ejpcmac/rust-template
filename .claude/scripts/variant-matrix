#!/bin/sh

# Renders the template for each project type and optionally runs the checks of
# the generated projects.

set -eu

usage() {
    cat >&2 <<EOF
usage: variant-matrix [options] <output directory>

Renders each project type into <output directory>/<variant>-<licence>, where
<variant> is the short name of the project type (minimal, cli, bare-metal,
embassy, rtic). The output directory must be empty or not exist, unless -u is
given.

When a render fails, the output of cargo-generate is in
<output directory>/<variant>-<licence>.render.log, and the next project type
is rendered all the same.

With -c, also runs \`cargo xtask check\` in the CI devshell of each render, and
writes the output to <output directory>/<variant>-<licence>.log. It prints a
\`pending\` line for each render first, a \`checking\` line when a render
starts and a \`done\` line with the counts at the end, and copies every line it
prints to <output directory>/summary. The renders are then formatted, as with -f, and
get a Git repository and a Cargo.lock: compare renders made without -c. The
build artifacts are deleted after the checks, unless -k is given.

With -u, a render that already exists in the output directory is updated in
place: the project type is rendered again into a temporary directory, then
synchronised into the render, keeping its build artifacts, its Git repository,
its Cargo.lock and its flake.lock, so that the next checks are incremental.
With -c, the changes are then committed and Cargo.lock is generated again. A
render that does not exist yet is rendered as without -u.

options:
  -r <revision>  template revision, as a jj revset (default: @)
  -t <variant>   project type to render, by name or short name; can be
                 repeated (default: all the project types of the revision)
  -l <licence>   licence to render, or \`all\`; can be repeated
                 (default: GPL-3.0)
  -f             format the renders, as the generation does when it is allowed
                 to run commands; this builds the devshell of each render
  -c <check>     check to run, as taken by \`cargo xtask check\`, or \`all\`;
                 can be repeated
  -k             keep the build artifacts of the checks
  -u             update the existing renders in place; implies -k
  -j <jobs>      number of project types to render and check at once, or
                 \`all\` for every selected project type (default: 1)
EOF
    exit 2
}

die() {
    echo "variant-matrix: $1" >&2
    exit 1
}

# Prints the items of a list defined in scripts/options.rhai, one per line.
options_list() {
    echo "$options" |
        sed -n "/^export const $1 = \[/,/^\];/p" |
        sed -n 's/^ *"\(.*\)",$/\1/p'
}

short_name() {
    echo "$1" | sed 's/^Embedded (\(.*\))$/\1/' | tr 'A-Z ' 'a-z-'
}

# Tells whether a line-separated list contains an item.
contains() {
    echo "$1" | grep -qxF -- "$2"
}

commit() {
    git -c user.name=variant-matrix \
        -c user.email=variant-matrix@localhost \
        -c commit.gpgsign=false \
        commit -q -m "$1"
}

# Commits the staged changes, if there are any.
commit_staged() {
    git diff --cached --quiet || commit "$1"
}

run_checks() {
    # NOTE: `set -e` has no effect here, as the function is called in an `if`.
    (
        cd "$1" || exit 1

        # The checks need a Git repository on the main branch, with the lock
        # files committed. An updated render already has one.
        if [ -d .git ]; then
            render_message="chore: update the render"
            lock_message="chore: update the lock file"
        else
            git init -q -b main || exit 1
            render_message="chore: render the template"
            lock_message="chore: add the lock file"
        fi

        git add -A &&
            commit_staged "$render_message" &&
            nix develop .#ci -c cargo generate-lockfile </dev/null &&
            git add -A &&
            commit_staged "$lock_message" ||
            exit 1

        status=0
        while IFS= read -r check; do
            if [ "$check" = "all" ]; then
                nix develop .#ci -c cargo xtask check </dev/null || status=1
            else
                nix develop .#ci -c cargo xtask check "$check" </dev/null ||
                    status=1
            fi
        done <<EOF
$checks
EOF
        exit "$status"
    ) >"$1.log" 2>&1
}

# Renders a project type again into a temporary directory, then synchronises it
# into an existing render. The lock file of the firmware workspace is not kept:
# it is untracked and created by the checks, as in a fresh render.
update_render() {
    render="$1"
    shift

    rm -rf "$render.update" "$render.update.render.log"
    if ! "$scripts/render" "$@" "$render.update" >/dev/null 2>&1; then
        mv "$render.update.render.log" "$render.render.log"
        rm -rf "$render.update"
        return 1
    fi

    rsync -a --checksum --delete \
        --exclude=/target/ \
        --exclude=/.git/ \
        --exclude=/Cargo.lock \
        --exclude=/flake.lock \
        "$render.update/" "$render/" >"$render.render.log" 2>&1 ||
        return 1
    rm -rf "$render.update" "$render.render.log"
}

# Prints a line of the summary, and copies it to the summary file when there
# are checks to run.
report() {
    echo "$1"
    [ -z "$checks" ] || echo "$1" >>"$output/summary"
}

# Renders a project type with a licence, then runs the checks, if any.
process() {
    # NOTE: `set -e` has no effect here, as the function is called before `||`.
    render="$output/$(short_name "$1")-$2"

    [ -z "$checks" ] || report "checking  $render"
    rm -f "$render.render.log"
    if [ "$update" = true ] && [ -d "$render" ]; then
        done_message="updated "
        update_render "$render" -r "$revision" -t "$1" -l "$2" $format
    else
        done_message="rendered"
        "$scripts/render" -r "$revision" -t "$1" -l "$2" $format "$render" \
            >/dev/null 2>&1
    fi
    # shellcheck disable=SC2181
    if [ $? -ne 0 ]; then
        report "FAILED    $render  (cannot render, see $render.render.log)"
        echo >>"$failures"
        return
    fi

    if [ -z "$checks" ]; then
        report "$done_message  $render"
        return
    fi

    start=$(date +%s)
    if run_checks "$render"; then
        result="passed  "
        echo >>"$passes"
    else
        result="FAILED  "
        echo >>"$failures"
    fi
    if [ "$keep_artifacts" = false ]; then
        find "$render" -type d -name target -prune -exec rm -rf {} +
    fi
    report "$result  $render  ($(($(date +%s) - start)) s, see $render.log)"
}

revision="@"
variants=""
licences=""
checks=""
format=""
keep_artifacts=false
update=false
jobs=1

while getopts "r:t:l:fc:kuj:" option; do
    case "$option" in
        r) revision="$OPTARG" ;;
        t) variants="${variants:+$variants
}$OPTARG" ;;
        l) licences="${licences:+$licences
}$OPTARG" ;;
        f) format="-f" ;;
        c)
            format="-f"
            checks="${checks:+$checks
}$OPTARG"
            ;;
        k) keep_artifacts=true ;;
        u)
            update=true
            keep_artifacts=true
            ;;
        j) jobs="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage

case "$jobs" in
    all) ;;
    "" | *[!0-9]* | 0*) die "-j takes a positive number or \`all\`" ;;
esac

scripts=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$scripts/../.." && pwd)

# Resolve the revision once, so that every render is of the same commit, even
# when the working copy changes during the run.
commit=$(cd "$root" && jj log --no-graph -r "$revision" -T 'commit_id ++ "\n"') ||
    die "cannot resolve the revision \`$revision\`"
[ "$(echo "$commit" | wc -l)" -eq 1 ] && [ -n "$commit" ] ||
    die "the revision \`$revision\` must resolve to exactly one commit"
revision="$commit"

# The project types and licences are those of the rendered revision.
options=$(cd "$root" && jj file show -r "$revision" scripts/options.rhai) ||
    die "cannot read scripts/options.rhai at \`$revision\`"
project_types=$(options_list PROJECT_TYPES)
known_licences=$(options_list LICENSES)
[ -n "$project_types" ] && [ -n "$known_licences" ] ||
    die "cannot read the project types and licences at \`$revision\`"

if [ -z "$licences" ]; then
    licences="GPL-3.0"
elif contains "$licences" all; then
    licences="$known_licences"
fi

if [ -n "$variants" ]; then
    selected=""
    while IFS= read -r project_type; do
        if contains "$variants" "$project_type" ||
            contains "$variants" "$(short_name "$project_type")"; then
            selected="${selected:+$selected
}$project_type"
        fi
    done <<EOF
$project_types
EOF
    [ "$(echo "$selected" | wc -l)" -eq "$(echo "$variants" | wc -l)" ] ||
        die "unknown project type in: $(echo "$variants" | tr '\n' ' ')"
    project_types="$selected"
fi

[ "$jobs" = all ] && jobs=$(echo "$project_types" | wc -l)

mkdir -p "$1"
output=$(cd "$1" && pwd)
[ "$update" = true ] || [ -z "$(ls -A "$output")" ] ||
    die "$output is not empty"

# The summary is that of this run only.
rm -f "$output/summary"

state=$(mktemp -d)
trap 'rm -rf "$state"' EXIT

# Each passed or failed render adds a line to one of these files, as the
# renders run in background jobs, which cannot share a counter.
passes="$state/passes"
failures="$state/failures"
: >"$passes"
: >"$failures"

# List the renders to check before any starts, so that the summary shows the
# whole run from its beginning.
if [ -n "$checks" ]; then
    while IFS= read -r project_type; do
        while IFS= read -r licence; do
            report "pending   $output/$(short_name "$project_type")-$licence"
        done <<EOF
$licences
EOF
    done <<EOF
$project_types
EOF
fi

# Limit the number of jobs with tokens in a FIFO: a job takes one before it
# starts and gives it back when it ends.
mkfifo "$state/tokens"
exec 3<>"$state/tokens"
i=0
while [ "$i" -lt "$jobs" ]; do
    echo >&3
    i=$((i + 1))
done

while IFS= read -r project_type; do
    while IFS= read -r licence; do
        read -r _ <&3
        (
            process "$project_type" "$licence" 3>&- || :
            echo >&3
        ) &
    done <<EOF
$licences
EOF
done <<EOF
$project_types
EOF
wait

count=$(wc -l <"$failures")
[ -z "$checks" ] ||
    report "done      $(wc -l <"$passes") passed, $count failed"
[ "$count" -eq 0 ] || die "$count render(s) have failed"
